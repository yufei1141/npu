bank=(kvHead,dimGroup8)
word=32 positions x 8 dims
row=position/32",fillcolor="#e5f5ed"];
v [label="V view
bank=(kvHead,dim mod32)
word=8 positions
row=(dim/32)*16+position/8",fillcolor="#e5f5ed"];
