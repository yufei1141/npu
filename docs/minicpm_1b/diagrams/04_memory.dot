kv->rd[label="Historical KV",color="#306d73",penwidth=1.3];
scratch->rd[label="Prefill loads",color="#306d73",penwidth=1.3];
rd->local[label="Reorder / pack / ready",color="#306d73",penwidth=1.3];
local->wr[label="Store / append",color="#306d73",penwidth=1.3];
