digraph G {
graph[rankdir=LR,bgcolor="white",pad="0.25",nodesep="0.4",ranksep="0.55"];
node[shape=box,style="rounded,filled",fontname="DejaVu Sans",fontsize=11,color="#6b8197",margin="0.15,0.1"];
edge[fontname="DejaVu Sans",fontsize=9,arrowsize=0.7];
pool[label="DDR region allocator
64-bit physical addresses",fillcolor="#fff2d9"];
weight[label="Canonical W4 body
~258 MB incl scales/zeros",fillcolor="#e6f5ee"];
head[label="Native16 embedding/head
508 MB; alias to verify",fillcolor="#e6f5ee"];
